// Upload gambar
const uploadImage = async (file) => {
  const formData = new FormData();
  formData.append('image', file);
  
  const response = await fetch('http://localhost:3001/process-image', {
    method: 'POST',
    body: formData
  });
  
  return await response.json();
};

// Ambil data LCI
const fetchLCIData = async () => {
  const response = await fetch('http://localhost:3001/lci/data', {
    method: 'GET',
    headers: {
      'x-lci-access': 'your-lci-token-here'
    }
  });
  
  return await response.json();
};